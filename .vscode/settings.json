{
	"chat.tools.terminal.autoApprove": {
		"/^make test( PE_COUNT=[0-9]+ WEIGHT_W=[0-9]+ IDLE_W=[0-9]+( EVENT_FIFO_DEPTH=[0-9]+)?)?$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^make bitstream( PE_COUNT=[0-9]+ WEIGHT_W=[0-9]+ IDLE_W=[0-9]+( EVENT_FIFO_DEPTH=[0-9]+)?)?$/": {
			"approve": true,
			"matchCommandLine": true
		},
		"/^set -o pipefail; make test 2>&1 \\| grep -E 'PASS:\\|All \\.\\* tests passed\\|FATAL:\\|error:\\|syntax error\\|make: \\(\\\\\\*\\\\\\*\\\\\\*\\|Warning\\|warning:\\)'$/": {
			"approve": true,
			"matchCommandLine": true
		}
	},
	"python-envs.defaultEnvManager": "ms-python.python:system"
}